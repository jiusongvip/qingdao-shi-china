---
import Layout from "../layouts/Layout.astro";
import attractionsJson from "../data/attractions.json";

interface Attraction { name: string; type: string; area: string; price: string; duration: string; suit: string; photo: string; desc: string; }
interface Hotel { name: string; area: string; type: string; price: string; beach: string; metro: string; english: string; bestFor: string; rating: number; }
interface FoodPick { name: string; cn: string; area: string; type: string; price: string; desc: string; }

const attractions: Attraction[] = [
  { name: "Zhanqiao Pier", type: "landmark", area: "shinan", price: "free", duration: "1h", suit: "all", photo: "/images/zhanqiao-pier.webp", desc: "Iconic 440m pier stretching into the Yellow Sea. Best at sunrise when locals practice tai chi. The octagonal pavilion at the end is Qingdao's postcard image. Go before 9am to avoid crowds." },
  { name: "Badaguan Scenic Area", type: "architecture", area: "shinan", price: "free", duration: "2h", suit: "couples", photo: "/images/badaguan-architecture.webp", desc: "Tree-lined streets named after ancient Chinese military passes. Over 200 German-era villas in Gothic, Baroque, and Rococo styles. Magical in cherry blossom (April) and autumn leaves (October). Free to wander." },
  { name: "Tsingtao Beer Museum", type: "beer", area: "shibei", price: "60", duration: "2h", suit: "all", photo: "/images/tsingtao-beer.webp", desc: "Housed in the original 1903 brewery. Vintage copper kettles, modern bottling line, and two free glasses of unfiltered draft Tsingtao at the end. Ticket Y=60 includes tastings." },
  { name: "Laoshan Mountain", type: "nature", area: "laoshan", price: "130", duration: "day", suit: "all", photo: "/images/laoshan-mountain.webp", desc: "Sacred Taoist mountain rising 1,133m from the coastline. Taiqing Palace dates back to 140 BC. Hike for sea views and ancient temples. Start at 8am to beat tour groups. Bus 304 or Didi (40 min)." },
  { name: "May Fourth Square", type: "landmark", area: "shinan", price: "free", duration: "1h", suit: "all", photo: "/images/may-fourth-square.webp", desc: "Qingdao's modern civic heart. The red Wind of May sculpture marks the spot. Locals fly kites, skateboard, and dance at dusk. Seaside promenade starts here, stretching 3km east." },
  { name: "Golden Beach", type: "beach", area: "huangdao", price: "free", duration: "half", suit: "families", photo: "/images/golden-beach.webp", desc: "Best sand beach in Qingdao on Huangdao Island. 3.5km of fine golden sand. Cross-bay ferry from city (20 min). Water swimmable June-September. Wide enough it never feels crowded." },
  { name: "St. Michael's Cathedral", type: "architecture", area: "shinan", price: "10", duration: "1h", suit: "all", photo: "/images/st-michaels-cathedral.webp", desc: "Twin-spired Neo-Romanesque cathedral built 1932-1934 by German architects. Largest Catholic church in Qingdao with stunning stained glass and vaulted ceilings. Active parish. Y=10 entry." },
  { name: "Underwater World", type: "museum", area: "shinan", price: "130", duration: "3h", suit: "families", photo: "/images/underwater-world.webp", desc: "China's first aquarium (1932). 86m moving walkway through a transparent tunnel with sharks, rays, and sea turtles overhead. Good rainy-day option. Y=130 adult." },
  { name: "Olympic Sailing Center", type: "landmark", area: "shinan", price: "free", duration: "1h", suit: "all", photo: "/images/olympic-sailing-center.webp", desc: "2008 Beijing Olympics sailing venue. Marina lined with yachts and waterfront bars. Walk from May Fourth Square (10 min east). Boat rides from Y=50. Best at sunset." },
  { name: "Xiaoyushan Park", type: "nature", area: "shinan", price: "15", duration: "1h", suit: "photographers", photo: "/images/xiaoyushan-park.webp", desc: "Hilltop park with the best panoramic view of Old Town red-tiled roofs against the sea. Climb the three-story pagoda for 360-degree views. Photographers: go at golden hour." },
  { name: "Qingdao TV Tower", type: "landmark", area: "shinan", price: "50", duration: "1h", suit: "all", photo: "/images/qingdao-tv-tower.webp", desc: "232m observation deck with glass floor sections. Best city views on a clear day: see from Old Town to Huangdao. Go after 4pm for sunset. The revolving restaurant is overpriced; eat elsewhere. Y=50." },
  { name: "Silver Beach", type: "beach", area: "huangdao", price: "free", duration: "half", suit: "all", photo: "/images/silver-beach.webp", desc: "Golden Beach's quieter neighbor, 2km west. Fewer crowds, same fine sand. Popular with locals for weekend barbecues. Peaceful alternative when Golden Beach is packed. Accessible by the same ferry + short bus ride." },
];

const hotels: Hotel[] = [
  { name: "Shangri-La Qingdao", area: "shinan", type: "luxury", price: "\-200", beach: "15min walk", metro: "3min", english: "Yes", bestFor: "Business, families", rating: 9.2 },
  { name: "Old Town Hostel", area: "oldtown", type: "hostel", price: "\-20", beach: "5min walk", metro: "8min", english: "Partial", bestFor: "Backpackers", rating: 8.5 },
  { name: "Holiday Inn Qingdao", area: "shinan", type: "mid", price: "\-90", beach: "10min walk", metro: "5min", english: "Yes", bestFor: "Couples, first-timers", rating: 8.7 },
  { name: "Home Inn (Rujia)", area: "shibei", type: "budget", price: "\-35", beach: "20min bus", metro: "2min", english: "No", bestFor: "Budget travelers", rating: 7.8 },
  { name: "Laoshan Sea View B&B", area: "laoshan", type: "bnb", price: "\-80", beach: "2min walk", metro: "15min bus", english: "Some", bestFor: "Nature lovers", rating: 9.0 },
  { name: "InterContinental Qingdao", area: "shinan", type: "luxury", price: "\-250", beach: "5min walk", metro: "5min", english: "Yes", bestFor: "Luxury travelers", rating: 9.3 },
  { name: "Qingdao Kaiyue Hostel", area: "oldtown", type: "hostel", price: "\-15", beach: "10min walk", metro: "10min", english: "Yes", bestFor: "Solo travelers", rating: 8.9 },
  { name: "Crowne Plaza Qingdao", area: "shibei", type: "mid", price: "\-110", beach: "15min walk", metro: "2min", english: "Yes", bestFor: "Business travelers", rating: 8.6 },
];

const foodPicks: FoodPick[] = [
  { name: "Chunhelou Restaurant", cn: "chun he lou", area: "shinan", type: "seafood", price: "\$\$", desc: "Classic Shandong cuisine since 1891. Try the sweet and sour carp (tang cu li yu) and jiaozi dumplings." },
  { name: "Qingdao Beer Street", cn: "Dengzhou Lu pi jiu jie", area: "shibei", type: "beer", price: "\$", desc: "Dengzhou Lu. Outdoor seating, fresh draft Tsingtao by the jug, grilled squid skewers (kao you yu). Order san pi: original, dark, and green IPA-style." },
  { name: "Yunxiao Road Food Street", cn: "Yunxiao Lu mei shi jie", area: "shinan", type: "seafood", price: "\$\$", desc: "Dozens of seafood restaurants. Pick live seafood from tanks — try spicy clams (la chao ge li) and beer-battered prawns." },
  { name: "Pichai Yuan Food Court", cn: "Pi Chai Yuan", area: "oldtown", type: "street", price: "\$", desc: "Historic food alley since 1902. Grilled squid, Qingdao potstickers (guo tie), lamb skewers (yang rou chuan). A local institution." },
  { name: "Kaiyue Western Restaurant", cn: "Kai Yue xi can ting", area: "shinan", type: "western", price: "\$\$\$", desc: "German-style restaurant near the cathedral. Sausages, sauerkraut, and imported beers. Good break from Chinese food if you need one." },
  { name: "Minjiang Road Night Market", cn: "Minjiang Lu ye shi", area: "shinan", type: "street", price: "\$", desc: "50+ stalls, best after 7pm. Try jianbing (savory crepe with egg and crispy wonton) and chou doufu if you are brave. Cash mostly not accepted — use Alipay." },
  { name: "Haidilao Hot Pot", cn: "Hai Di Lao huo guo", area: "shibei", type: "chinese", price: "\$\$", desc: "China's most famous hot pot chain. English tablet ordering. Free snacks while you wait. Try the signature spicy broth with hand-pulled noodles (la mian)." },
  { name: "Qingdao Coffee Street", cn: "Da xue lu ka fei jie", area: "shinan", type: "cafe", price: "\$\$", desc: "University Road (Da Xue Lu) area. Independent cafes in converted German buildings. Good WiFi, great for a rest stop between attractions." },
];

const faqItems = [
  { q: "Do I need a visa to visit Qingdao?", a: "Most foreign visitors need a Chinese visa. Qingdao offers 144-hour visa-free transit for eligible nationalities arriving at Qingdao Liuting Airport and departing to a third country. Check the latest policy before booking." },
  { q: "How do I pay for things in Qingdao?", a: "Alipay and WeChat Pay dominate. Both now support linking foreign Visa and Mastercard. Set up Alipay before arriving: download the app, register with passport, link your card. Cash is accepted but increasingly rare." },
  { q: "Do I need a VPN in China?", a: "Yes. Google, Gmail, Instagram, WhatsApp, and many Western sites are blocked. Install a VPN on all devices before your flight. Test it before you leave. ExpressVPN and Astrill are commonly recommended by travelers." },
  { q: "Is Qingdao safe for tourists?", a: "Very safe. Violent crime against tourists is extremely rare. The main risk is taxi scams at the airport (use Didi instead) and pickpocketing in crowded areas during the Beer Festival." },
  { q: "When is the best time to visit?", a: "May-June and September-October for the best weather. July-August is peak season (hot, humid, Beer Festival crowds). November-April is off-season: cold but hotels are 50-70% cheaper." },
  { q: "Can I use English in Qingdao?", a: "Limited. Hotel front desks and major attractions usually have some English. Restaurants and taxis generally do not. Download Google Translate with offline Chinese. Screenshot key phrases before you go." },
];

const areaLabel = (a: string) => { const m: Record<string,string> = {shinan:"Shinan", shibei:"Shibei", oldtown:"Old Town", laoshan:"Laoshan", huangdao:"Huangdao"}; return m[a]||a; };
const typeLabel = (t: string) => { const m: Record<string,string> = {luxury:"Luxury", hostel:"Hostel", mid:"Mid-range", budget:"Budget", bnb:"B&B"}; return m[t]||t; };
const durLabel = (d: string) => { const m: Record<string,string> = {day:"Full day", half:"Half day"}; return m[d]||d; };
const attrTypeLabel = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const foodTypeLabel = (t: string) => { const m: Record<string,string> = {seafood:"Seafood", beer:"Beer", street:"Street Food", western:"Western", chinese:"Chinese", cafe:"Cafe"}; return m[t]||t; };
// Use the authoritative slug from attractions.json so homepage links always match detail pages
const normalize = (s: string) => s.toLowerCase().replace(/\\u2019|\\u2018|[\u2019\u2018`]/g, "'");
const slugByKey = new Map(attractionsJson.map((a: any) => [normalize(a.name), a.slug]));
const getSlug = (n: string) => {
  const fromJson = slugByKey.get(normalize(n));
  if (fromJson) return fromJson;
  return n.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
};
---

<Layout
  title="Qingdao Shi China — City Guide, Weather, Travel Tips & Tsingtao Beer"
  description="Discover Qingdao Shi, China: the coastal city that made Chinese beer famous. Travel guide, weather, 2-5 day itineraries, top attractions, hotels, food & insider tips."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-white">
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 grid md:grid-cols-2 gap-0 min-h-[85dvh] md:min-h-[75dvh]">
      <div class="flex flex-col justify-center py-12 md:py-20 md:pr-8">
        <nav class="caption text-xs mb-4" aria-label="Breadcrumb"><a href="/" class="text-[var(--color-accent)] hover:underline">Home</a> <span class="text-[var(--color-text-tertiary)]">/</span> <a href="/qingdao-attractions" class="text-[var(--color-accent)] hover:underline">Attractions</a> <span class="text-[var(--color-text-tertiary)]">/</span> <span class="text-[var(--color-text-tertiary)]">Qingdao Shi</span></nav>
        <p class="text-sm font-semibold text-[var(--color-accent)] uppercase tracking-wide mb-4">Qingdao Shi, Shandong Province, China</p>
        <h1 class="text-4xl md:text-6xl tracking-tight leading-none font-bold text-[var(--color-text)]">Qingdao Shi,<br/>China: Beaches, Beer &<br/>Bavaria by the Sea</h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mt-6 max-w-[60ch]">Qingdao Shi (青岛市, "Qingdao city") is the coastal city that made Chinese beer famous. German-era red-tiled roofs, sandy beaches, sacred Taoist mountains, and the freshest seafood in northern China — all wrapped in one of the country’s most relaxed waterfront cities.</p>
        <div class="flex flex-wrap gap-3 mt-8">
          <a href="/qingdao-itineraries/3-days" class="btn-primary text-base px-6 py-3">3-Day Itinerary</a>
          <a href="#why-qingdao" class="btn-outline text-base px-6 py-3">Why visit Qingdao?</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-4 mt-10">
          <div><p class="text-xl font-bold text-[var(--color-text)]">9.4M</p><p class="caption">Population</p></div>
          <div><p class="text-xl font-bold text-[var(--color-text)]">May-Oct</p><p class="caption">Best Season</p></div>
          <div><p class="text-xl font-bold text-[var(--color-text)]">$30-80</p><p class="caption">Daily Budget</p></div>
          <div><p class="text-xl font-bold text-[var(--color-text)]">CNY ¥</p><p class="caption">Currency</p></div>
          <div><p class="text-xl font-bold text-[var(--color-text)]">Mandarin</p><p class="caption">Language</p></div>
          <div><p class="text-xl font-bold text-[var(--color-text)]">UTC+8</p><p class="caption">Time Zone</p></div>
        </div>
      </div>
      <div class="relative h-64 md:h-full min-h-[320px]">
        <img src="/images/qingdao-coastline-hero.webp" alt="Qingdao coastline with red-tiled roofs and the sea" class="absolute inset-0 w-full h-full object-cover" loading="eager" />
        <div class="absolute bottom-0 left-0 right-0 p-4 text-xs text-white/60 text-right">Last updated: August 2026 &mdash; based on multiple on-the-ground visits and ongoing research</div>
      </div>
    </div>
  </section>

  <!-- Quick Answers (Top Questions) -->
  <section class="section-sm border-t" id="quick-answers">
    <div class="container">
      <div class="mb-8"><p class="tag mb-3">Quick Answers</p><h2 class="h3">Your first questions about Qingdao, answered</h2></div>
      <div class="grid md:grid-cols-2 gap-3">
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">Where is Qingdao?</h3>
          <p class="caption text-xs leading-relaxed">Qingdao Shi (青岛市) is a coastal port city on the southern shore of the Shandong Peninsula in eastern China, on the Yellow Sea. It sits at the eastern entrance to Jiaozhou Bay, one of northern China's best natural harbors — roughly halfway between Beijing (3-4h by high-speed rail) and Shanghai.</p>
        </div>
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">What is Qingdao famous for?</h3>
          <p class="caption text-xs leading-relaxed">Three things: the Tsingtao Brewery (founded 1903 by Germans, China's most famous beer export), miles of sandy beaches, and German colonial architecture with red-tiled roofs. It hosted the 2008 Olympic sailing events.</p>
        </div>
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">Why is it called "Qingdao Shi"?</h3>
          <p class="caption text-xs leading-relaxed">"Shi" (市) is the Chinese word for city, so Qingdao Shi literally means "Qingdao City." The name Qingdao means "Green Island." You'll also see it romanized as Tsingtao (the beer spelling) — same place.</p>
        </div>
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">When is the best time to visit?</h3>
          <p class="caption text-xs leading-relaxed">May-June and September-October for the best weather and manageable crowds. July-August is peak beach and beer-festival season (hot and busy). November-April is cheap and quiet but cold. See the <a href="#best-time" class="text-[var(--color-accent)] hover:underline font-medium">season-by-season guide</a>.</p>
        </div>
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">Is Qingdao worth visiting?</h3>
          <p class="caption text-xs leading-relaxed">Yes — it's one of China's most relaxed, walkable cities and a gentler introduction than Beijing or Shanghai. You can hike a sacred Taoist mountain in the morning and be on the beach by afternoon. <a href="#why-qingdao" class="text-[var(--color-accent)] hover:underline font-medium">Read why travelers return</a>.</p>
        </div>
        <div class="card p-5">
          <h3 class="text-sm font-semibold mb-2">Do foreigners need a visa?</h3>
          <p class="caption text-xs leading-relaxed">Most nationalities need a Chinese tourist visa (L). Qingdao offers 144-hour visa-free transit at the airport for eligible countries when continuing to a third destination. <a href="/faq" class="text-[var(--color-accent)] hover:underline font-medium">Full visa FAQ</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Best Time to Visit -->
  <section class="section border-t" id="best-time">
    <div class="container">
      <div class="mb-10"><p class="tag mb-3">When to Go</p><h2>Best time to visit Qingdao</h2><p class="body mt-3 max-w-[65ch]">Qingdao has a temperate monsoon climate with four distinct seasons. The sweet spot is May-June and September-October, when skies are clear, temperatures sit in the low 20s (&deg;C), and crowds are manageable. Summer brings the famous Tsingtao Beer Festival but also humidity and peak prices. Winter is cold and windy but hotel rates drop by half.</p></div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-5">
          <p class="text-xs font-semibold text-[var(--color-accent)] uppercase mb-2">Spring (Mar-May)</p>
          <p class="text-lg font-bold mb-1">8–20&deg;C</p>
          <p class="caption text-xs leading-relaxed">Cherry blossoms in April, comfortable temperatures. Occasional sandstorms from the north in early March. A light jacket is usually enough by May.</p>
          <p class="caption text-xs mt-2"><span class="text-green-600 font-semibold">Good time</span> &mdash; fewer crowds, fair weather</p>
        </div>
        <div class="card p-5 ring-2 ring-[var(--color-accent)]">
          <p class="text-xs font-semibold text-[var(--color-accent)] uppercase mb-2">Summer (Jun-Aug)</p>
          <p class="text-lg font-bold mb-1">22–28&deg;C</p>
          <p class="caption text-xs leading-relaxed">Peak beach season. The Tsingtao Beer Festival runs late July through August. Hot, humid, and crowded. Book hotels 2–3 months ahead for August.</p>
          <p class="caption text-xs mt-2"><span class="text-amber-600 font-semibold">Peak season</span> &mdash; book early, expect crowds</p>
        </div>
        <div class="card p-5 ring-2 ring-[var(--color-accent)]">
          <p class="text-xs font-semibold text-[var(--color-accent)] uppercase mb-2">Autumn (Sep-Nov)</p>
          <p class="text-lg font-bold mb-1">10–22&deg;C</p>
          <p class="caption text-xs leading-relaxed">The best season. Clear blue skies, golden light, comfortable temperatures. Swimming still possible through September. Perfect for photography at Badaguan.</p>
          <p class="caption text-xs mt-2"><span class="text-green-600 font-semibold">Best time</span> &mdash; ideal weather, moderate crowds</p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-semibold text-[var(--color-accent)] uppercase mb-2">Winter (Dec-Feb)</p>
          <p class="text-lg font-bold mb-1">-3–6&deg;C</p>
          <p class="caption text-xs leading-relaxed">Cold and windy but seldom below freezing. Hotels drop 50–70% in price. Empty beaches have a stark beauty. Few tourists anywhere.</p>
          <p class="caption text-xs mt-2"><span class="text-slate-500 font-semibold">Off season</span> &mdash; cheap, quiet, cold</p>
        </div>
      </div>
      <p class="caption mt-4">Detailed monthly breakdown, dressing guide, and live forecast: <a href="/qingdao-weather" class="text-[var(--color-accent)] hover:underline font-medium">Qingdao weather page</a></p>
    </div>
  </section>

  <!-- Why Qingdao -->
  <section class="section-sm border-t" id="why-qingdao">
    <div class="container max-w-4xl">
      <p class="tag mb-4">Why Qingdao?</p>
      <h2 class="mb-6">Three reasons travelers keep coming back</h2>
      <div class="space-y-4 body leading-relaxed text-[var(--color-text-secondary)]">
        <p><strong>It is the rare Chinese city where you can surf in the morning, drink world-famous beer at its source by lunch, and wander cobblestone streets lined with Bavarian architecture by afternoon.</strong> Qingdao (pronounced "ching-dow") sits on a peninsula jutting into the Yellow Sea in Shandong Province, about halfway between Beijing and Shanghai. Its coastline runs for over 860 kilometers, dotted with beaches, rocky headlands, and fishing villages that feel worlds away from China’s megacities.</p>
        <p>The city wears its colonial past openly. From 1898 to 1914, Qingdao was a German concession, and the legacy is everywhere: St. Michael’s Cathedral, the Governor’s Mansion, and entire neighborhoods of European-style villas with red-tiled roofs. The Germans also started what became <a href="/qingdao-beer" class="text-[var(--color-accent)] hover:underline font-medium">Tsingtao Brewery</a> in 1903. Today, Tsingtao is China’s most famous beer export, and the city celebrates it every August with one of Asia’s largest beer festivals.</p>
        <p>For nature lovers, <a href="#attractions" class="text-[var(--color-accent)] hover:underline font-medium">Laoshan Mountain</a> rises abruptly from the coast just east of town — one of China’s sacred Taoist peaks with temples, hiking trails, and sweeping views of the sea. On clear days you can hike up in the morning and be back on the beach by late afternoon. Qingdao is one of the few places in China where a hiking holiday and a beach holiday are the same trip.</p>
        <p>Compared to Beijing or Shanghai, Qingdao moves at a gentler pace. Locals call it a city for living, not just for working. You will see people flying kites at May Fourth Square, families digging clams at low tide, and groups of friends gathered around tables of grilled seafood and fresh draft beer. It is an excellent introduction to China for first-time visitors and a welcome breather for seasoned travelers.</p>
      </div>
      <div class="mt-8"><a href="/qingdao-travel-guide" class="btn-primary">Read the full travel guide &rarr;</a></div>
    </div>
  </section>

  
  <!-- Where to Stay -->
  <section class="section border-t" id="neighborhoods">
    <div class="container">
      <div class="mb-10"><p class="tag mb-3">Where to Stay</p><h2>Which neighborhood fits your trip?</h2><p class="body mt-3 max-w-[65ch]">Qingdao spreads across several distinct districts. Picking the right base makes or breaks your trip. Do not book before reading this — many first-timers end up in a business district 45 minutes from the Old Town.</p></div>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="card p-6 ring-2 ring-[var(--color-accent)]">
          <h3 class="font-semibold mb-1">Shinan District</h3>
          <p class="tag mb-3">Best for first-timers</p>
          <p class="caption text-xs leading-relaxed mb-3">The tourist core. Zhanqiao Pier, St. Michael''s Cathedral, Badaguan, May Fourth Square, and most restaurants are within walking distance. Prices are highest here.</p>
          <div class="caption text-xs space-y-1"><span class="font-medium">Hotel range:</span> Y=80-250/night<br/><span class="font-medium">Vibe:</span> Historic, walkable, tourist-friendly<br/><span class="font-medium">Best for:</span> First visit, couples, sightseeing</div>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold mb-1">Old Town (Zhongshan Lu)</h3>
          <p class="tag mb-3">Best for character</p>
          <p class="caption text-xs leading-relaxed mb-3">Cobblestones, German architecture, and the original 1898 street grid. Hostels and boutique hotels in converted villas. Close to the train station and ferry terminal.</p>
          <div class="caption text-xs space-y-1"><span class="font-medium">Hotel range:</span> Y=15-120/night<br/><span class="font-medium">Vibe:</span> Charming, slightly gritty, authentic<br/><span class="font-medium">Best for:</span> Backpackers, photographers, history buffs</div>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold mb-1">Shibei District</h3>
          <p class="tag mb-3">Best value</p>
          <p class="caption text-xs leading-relaxed mb-3">North of Shinan, where locals actually live. Beer Museum and Beer Street are here. Hotels 40-50% cheaper than Shinan. Metro to Old Town in 10 min.</p>
          <div class="caption text-xs space-y-1"><span class="font-medium">Hotel range:</span> Y=35-110/night<br/><span class="font-medium">Vibe:</span> Local, practical, less polished<br/><span class="font-medium">Best for:</span> Budget travelers, beer pilgrims</div>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold mb-1">Laoshan District</h3>
          <p class="tag mb-3">Best for nature</p>
          <p class="caption text-xs leading-relaxed mb-3">At the foot of Laoshan Mountain, 30-40 min east. Sea-view B&Bs, hiking at your doorstep, best sunrises in Qingdao. Not practical for a city-focused trip.</p>
          <div class="caption text-xs space-y-1"><span class="font-medium">Hotel range:</span> Y=60-200/night<br/><span class="font-medium">Vibe:</span> Scenic, quiet, remote<br/><span class="font-medium">Best for:</span> Hikers, nature lovers, retreats</div>
        </div>
        <div class="card p-6">
          <h3 class="font-semibold mb-1">Huangdao District</h3>
          <p class="tag mb-3">Best for beaches</p>
          <p class="caption text-xs leading-relaxed mb-3">Across the bay from the main city. Golden Beach and Silver Beach. Beer Festival in August. Ferry or 40-min tunnel taxi to Shinan. Quiet and spacious.</p>
          <div class="caption text-xs space-y-1"><span class="font-medium">Hotel range:</span> Y=50-180/night<br/><span class="font-medium">Vibe:</span> Beach town, family-friendly<br/><span class="font-medium">Best for:</span> Families, beach holiday, Beer Festival</div>
        </div>
        <div class="card p-6 bg-[var(--color-accent-subtle)]/30">
          <h3 class="font-semibold mb-1">Our Recommendation</h3>
          <p class="caption text-xs leading-relaxed">If this is your first visit: stay in <strong>Shinan District</strong>, somewhere between the train station and May Fourth Square. You will walk to 80% of the attractions on this page. If you are on a tight budget: Shibei near a metro station. If you have 4+ days: split your stay — 2 nights in Shinan, 2 nights in Laoshan.</p>
        </div>
      </div>
    </div>
  </section>
<!-- How to Get to Qingdao -->
  <section class="section border-t" id="get-there">
    <div class="container">
      <div class="mb-10"><p class="tag mb-3">Getting Here</p><h2>How to get to Qingdao</h2><p class="body mt-3 max-w-[65ch]">Qingdao is well-connected by air, high-speed rail, and ferry. Most international visitors arrive via a domestic connection from Beijing or Shanghai.</p></div>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="card p-6">
          <div class="text-2xl mb-3">✈️</div>
          <h3 class="text-base mb-2">By Air</h3>
          <p class="caption leading-relaxed">Qingdao Jiaodong International Airport (TAO) handles direct flights from Seoul, Tokyo, Osaka, Bangkok, and major Chinese cities. Metro Line 8 connects the airport to the city center in about 40 minutes. A Didi ride costs around ¥120–150.</p>
          <a href="/qingdao-transportation" class="text-sm font-medium text-[var(--color-accent)] mt-3 inline-block hover:underline">Airport guide &rarr;</a>
        </div>
        <div class="card p-6">
          <div class="text-2xl mb-3">🚆</div>
          <h3 class="text-base mb-2">By High-Speed Rail</h3>
          <p class="caption leading-relaxed">Beijing to Qingdao takes 3–4 hours (¥250–350). Shanghai to Qingdao takes 5–6 hours (¥300–400). Trains arrive at Qingdao Station (Old Town) or Qingdao North Station. Book on Trip.com or 12306.cn.</p>
          <a href="/qingdao-transportation" class="text-sm font-medium text-[var(--color-accent)] mt-3 inline-block hover:underline">Train guide &rarr;</a>
