---
import Layout from "../../layouts/Layout.astro";
const routes = [
  { path: "walking", icon: "&#9871;", title: "Walking Tour", desc: "Old Town self-guided walk. Start at Zhanqiao Pier, end at Badaguan. 5km, 2-3 hours, easy.", stops: ["Zhanqiao Pier", "St. Michael's Cathedral", "Lao She's Former Residence", "Qingdao Observatory", "No. 1 Bathing Beach", "Badaguan"], tips: "Wear comfortable shoes. Cobblestone streets in parts. Best in spring and autumn. Avoid midday summer heat.", start: "09:00", difficulty: "Easy" },
  { path: "cycling", icon: "&#128690;", title: "Cycling Route", desc: "Coastline ride from May Fourth Square to Shilaoren Beach. 20km, half day, mostly flat.", stops: ["May Fourth Square", "Olympic Sailing Center", "Yinhai Marina", "Polar Ocean World (rest stop)", "Shilaoren Beach"], tips: "Rent a bike near May Fourth Square (shared bikes available via Alipay). Avoid 7:30-9:00am rush hour. Dedicated bike lanes along most of the route. Bring water.", start: "08:00 or 15:00", difficulty: "Easy" },
  { path: "driving", icon: "&#128663;", title: "Driving Route", desc: "Full-day Laoshan Mountain loop with coastal stops. 80km, full day.", stops: ["Qingdao city center", "Laoshan Taiqing entrance", "Mountain villages", "Yangko Beach", "Diaolongzui Cape", "Shazikou fishing village", "Return to city"], tips: "International driving permit not accepted in China. Hire a car with driver (\u00A5400-600/day). Start by 7am to beat the tour buses. Mountain roads are well-maintained but winding.", start: "07:00", difficulty: "Moderate (driver does the work)" },
  { path: "photography", icon: "&#128247;", title: "Photography Route", desc: "Best photo spots in Qingdao, timed for golden hour.", stops: ["Zhanqiao Pier at sunrise (05:30 Jun, 07:00 Dec)", "Badaguan autumn leaves (Oct-Nov)", "Catholic Church from Zhongshan Road", "Laoshan Taiqing Palace for mountain mist", "Golden Beach sunset (17:30 summer)", "Qingdao Old Town rooftops from Xiaoyushan Park"], tips: "Bring a polarizing filter for beach shots. Tripod recommended for sunrise/sunset. Drone flights restricted in most tourist areas - check local rules. Best months: April-May (cherry blossoms), October-November (autumn colors).", start: "Sunrise to sunset", difficulty: "Easy to Moderate" }
];
---
<Layout title="Qingdao Routes — Walking, Cycling, Driving & Photography" description="Self-guided routes in Qingdao. Walking tour through Old Town, cycling along the coast, driving to Laoshan, and photography spots at golden hour." pageType="CollectionPage">
  <section class="section">
    <div class="container">
      <p class="tag mb-3">Routes</p>
      <h1 class="mb-2">Explore Qingdao Your Way</h1>
      <p class="body-lg mb-10 max-w-[65ch]">Four self-guided routes for walking, cycling, driving, and photography. Each with maps, stops, timing, and local tips.</p>
      {routes.map(r => (
        <div class="card p-6 md:p-8 mb-8" id={r.path}>
          <div class="flex items-start gap-4 mb-6">
            <span class="text-3xl" set:html={r.icon} />
            <div>
              <h2 class="h3 mb-1">{r.title}</h2>
              <p class="body">{r.desc}</p>
            </div>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            <div>
              <h3 class="text-sm font-semibold mb-3">Stops</h3>
              <ol class="caption space-y-2 list-decimal list-inside">
                {r.stops.map(s => <li>{s}</li>)}
              </ol>
            </div>
            <div>
              <h3 class="text-sm font-semibold mb-3">Tips</h3>
              <p class="caption">{r.tips}</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold mb-3">Details</h3>
              <div class="flex flex-col gap-2 caption">
                <p><span class="font-medium">Start:</span> {r.start}</p>
                <p><span class="font-medium">Difficulty:</span> <span class="tag">{r.difficulty}</span></p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
