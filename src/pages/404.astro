---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="The page you are looking for does not exist. Find Qingdao travel guides, weather, itineraries, and maps." noindex={true}>
  <section class="section">
    <div class="container text-center max-w-2xl">
      <p class="text-6xl font-bold text-[var(--color-accent)] mb-4">404</p>
      <h1 class="mb-4">Page Not Found</h1>
      <p class="body-lg mb-8">The page you are looking for does not exist. It may have moved or the URL might be mistyped.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn-primary text-base px-6 py-3">Go to Homepage</a>
        <a href="/qingdao-travel-guide/" class="btn-outline text-base px-6 py-3">Travel Guide</a>
        <a href="/qingdao-itineraries/3-days/" class="btn-outline text-base px-6 py-3">3-Day Itinerary</a>
      </div>
    </div>
  </section>
</Layout>
